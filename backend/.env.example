# =============================================================================
# AegisSOC Backend Environment Configuration (.env.example)
# =============================================================================

APP_NAME="AegisSOC Platform API"
APP_ENV=production
DEBUG=false
API_V1_STR=/api

SECRET_KEY=change_me_to_a_random_32_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_database_password_here
POSTGRES_DB=aegissoc
DATABASE_URL=postgresql+asyncpg://postgres:generate_strong_database_password_here@localhost:5432/aegissoc

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SIMULATE_ML_ENGINE=false
SIMULATE_THREAT_INTEL=false

# =============================================================================
# AegisSOC Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with production secrets.
# NEVER commit the actual '.env' file to version control.
# =============================================================================

# --- Application Core ---
APP_NAME="AegisSOC Platform API"
APP_ENV=production
DEBUG=false
API_V1_STR=/api

# --- Security & JWT Authentication ---
# Generate a cryptographically strong secret: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_32_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Server & Networking ---
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
ALLOWED_HOSTS=*
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_database_password_here
POSTGRES_DB=aegissoc
POSTGRES_PORT=5432
# Full connection string for SQLAlchemy asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:generate_strong_database_password_here@db:5432/aegissoc

# --- Threat Intelligence API Credentials (Optional External Providers) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- AI Security Analyst Provider Credentials (Configure at least one) ---
# Primary provider: 'gemini', 'openai', 'anthropic', 'ollama', or 'mock'
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Simulation & Offline Flags ---
SIMULATE_ML_ENGINE=false
SIMULATE_THREAT_INTEL=false

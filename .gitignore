# =============================================================================
# AegisSOC Git Ignore Configuration
# =============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python virtual environment & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.log

# Databases & local state
*.db
*.sqlite
*.sqlite3
aegissoc.db

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary exports
exports/*.csv
exports/*.json
